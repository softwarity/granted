<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.softwarity</groupId>
        <artifactId>quarkus-granted-parent</artifactId>
        <version>5.10.0</version>
    </parent>

    <artifactId>quarkus-granted-deployment</artifactId>
    <name>granted for Quarkus - deployment</name>
    <description>The build-time half of the granted extension: teaches Quarkus REST the @GrantedClaim,
        @GrantedUsername, @GrantedRoles and @GrantedTenant parameters.</description>

    <dependencies>
        <dependency>
            <groupId>io.softwarity</groupId>
            <artifactId>quarkus-granted</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-deployment</artifactId>
        </dependency>
        <!-- MethodScannerBuildItem: how a parameter Quarkus REST doesn't know gets its value. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-server-spi-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jsonp-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-tls-registry-deployment</artifactId>
        </dependency>
        <!-- HealthBuildItem: the readiness check, registered when quarkus-smallrye-health is present. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health-spi</artifactId>
        </dependency>
        <!-- AddToOpenAPIDefinitionBuildItem: each route's rule in the OpenAPI document, when quarkus-smallrye-openapi is present. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi-spi</artifactId>
        </dependency>
        <!-- The extension's own tests: an application built with it, and what fails its build or its start. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-internal</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The readiness check, registered or not by granted.health.enabled. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health-deployment</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The OpenAPI document, as quarkus-smallrye-openapi generates it with granted's rules. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi-deployment</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A test CA and the certificates it signs, for an IdP served over HTTPS. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
